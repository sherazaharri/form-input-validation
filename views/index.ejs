<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <ul>
        <% if (locals.users) { %>
            <% users.forEach(user => { %>
                <li>
                    ID: <%= user.id %>, Name: <%= user.firstName %> <%= user.lastName %>, Email: <%= user.email %>, Age: <%= user.age %>, Bio: <%= user.bio %>
                </li>
                <a href="/<%= user.id %>/update">Update</a>
                <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                </form>
            <% }); %>
        <% } %>
    </ul>
    <a href="/create">Create a user</a>
    <a href="/search">Search for a user</a>
    <p></p>
    <h2><%= title2 %></h1>
    <form action="/search" method="GET">
        <label for="firstName">First Name:</label>
        <input type="text" name="firstName" id="firstName" required>

        <label for="lastName">Last Name:</label>
        <input type="text" name="lastName" id="lastName" required>
        
        <label for="email">Email:</label>
        <input type="text" name="email" id="email" required>

        <button type="submit">Search</button>
    </form>
</body>
</html>