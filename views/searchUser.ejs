<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <% if (users.length !== 0) { %>
        <% users.forEach(user => { %>
            <li>
                ID: <%= user.id %>, Name: <%= user.firstName %> <%= user.lastName %>, Email: <%= user.email %>, Age: <%= user.age %>, Bio: <%= user.bio %>
            </li>
        <% }) %>
    <% } else { %>
        <p><%= message %></p>
    <% } %>
     
    <a href="/">Back to home</a>
</body>
</html>